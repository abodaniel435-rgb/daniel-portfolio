APP_NAME="PayRite"
APP_URL="https://payrite.yourdomain.com"
APP_TIMEZONE="Africa/Lagos"
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=payrite
DB_USER=payrite_user
DB_PASS=change-me

# Used once by public/install.php, then keep it private.
INSTALL_KEY=change-this-install-key

# The single authorised administrator. install.php reads these values and never
# writes them anywhere else; the password is hashed before it reaches MySQL.
ADMIN_NAME="Abo Daniel"
ADMIN_EMAIL=abodaniel435@gmail.com
ADMIN_PASSWORD=change-this-admin-password

# Optional. Only the CLI installer reads it, and only to create the three
# @payrite.test demo staff logins so a reviewer can see the employee side.
# Leave it unset (and the file without the key) for a real deployment.
DEMO_PASSWORD=

# false keeps every message in the email_outbox table without sending it, which
# is what you want until the SPF and DKIM records for MAIL_FROM are in place.
# Delivery uses PHP's mail() — cPanel's own transport — so there is no SMTP
# password to store.
MAIL_ENABLED=false
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="PayRite"
