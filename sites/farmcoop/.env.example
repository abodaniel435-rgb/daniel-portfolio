APP_NAME="FarmCoop"
APP_URL="https://yourdomain.com/farmcoop"
APP_TIMEZONE="Africa/Lagos"
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=farmcoop
DB_USER=farmcoop_user
DB_PASS=change-me

# cPanel local mail() delivery. Keep false until the mailbox exists.
MAIL_ENABLED=false
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="FarmCoop"

# Used once by public/install.php and core/cli/install.php, then keep private.
INSTALL_KEY=change-this-install-key
ADMIN_EMAIL=abodaniel435@gmail.com
ADMIN_PASSWORD=change-this-admin-password
DEMO_PASSWORD=

# Protects /cron/run.php?key=... when cron calls the URL.
CRON_SECRET=change-this-cron-secret
