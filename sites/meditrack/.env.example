# cPanel local mail() delivery. Set to true only after creating the email account.
MAIL_ENABLED=false
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="MediTrack"

# Used once by public/install.php, then keep it private.
INSTALL_KEY=change-this-install-key
ADMIN_EMAIL=abodaniel435@gmail.com
ADMIN_PASSWORD=change-this-admin-password
DEMO_PASSWORD=
CRON_SECRET=change-this-cron-secret
