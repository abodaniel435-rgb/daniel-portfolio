APP_NAME="MediTrack"
APP_URL="https://yourdomain.com/meditrack"
APP_TIMEZONE="Africa/Lagos"
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=meditrack
DB_USER=meditrack_user
