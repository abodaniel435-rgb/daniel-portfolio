APP_NAME="NairaDesk"
APP_URL="https://nairadesk.yourdomain.com"
APP_TIMEZONE="Africa/Lagos"
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nairadesk
DB_USER=nairadesk_user
DB_PASS=change-me

# Used once by public/install.php, then keep it private.
INSTALL_KEY=change-this-install-key

# The single authorised administrator. install.php reads these two values and
# never writes them anywhere else; the password is hashed before it reaches MySQL.
ADMIN_NAME="Abo Daniel"
ADMIN_EMAIL=abodaniel435@gmail.com
ADMIN_PASSWORD=change-this-admin-password

MAIL_ENABLED=false
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="NairaDesk"
