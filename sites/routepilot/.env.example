APP_NAME="RoutePilot"
APP_URL="https://yourdomain.com/routepilot"
APP_TIMEZONE="Africa/Lagos"
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=routepilot
DB_USER=routepilot_user
DB_PASS=change-me

# cPanel local mail() delivery. Set to true only after creating the email account.
MAIL_ENABLED=false
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="RoutePilot"

# Used once by public/install.php, then keep it private.
INSTALL_KEY=change-this-install-key
ADMIN_EMAIL=abodaniel435@gmail.com
# Set ADMIN_PASSWORD and DEMO_PASSWORD for the CLI installer only.
ADMIN_PASSWORD=
DEMO_PASSWORD=
# Protects /cron/run.php?key=... when cron calls the URL instead of the CLI.
CRON_SECRET=change-this-cron-secret
