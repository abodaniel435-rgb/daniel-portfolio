# Database. Leave unset to use SQLite at database/hotel_miramar.db.
# On cPanel MySQL use the PyMySQL driver (installed from requirements.txt):
# DATABASE_URL=mysql+pymysql://cpaneluser:DBPASSWORD@localhost/cpaneluser_miramar

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# Gmail SMTP (recommended for Hotel Miramar live emails).
# 1. Google Account > Security > 2-Step Verification ON
# 2. Security > App passwords > create "Hotel Miramar" > copy 16-char code
# 3. Put your Gmail + 16-char code below, set MAIL_SUPPRESS_SEND=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=abodaniel435@gmail.com
MAIL_PASSWORD=replace-with-gmail-16-char-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=Hotel Miramar SG <abodaniel435@gmail.com>
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Keep true while testing without SMTP. Set false to actually send.
MAIL_SUPPRESS_SEND=true

# Initial authorised administrator (created on first seed only)
ADMIN_EMAIL=abodaniel435@gmail.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
