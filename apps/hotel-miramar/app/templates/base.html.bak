<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ hotel_name }}{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lucide-static@0.321.0/font/lucide.min.css">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
  {% block extra_css %}{% endblock %}
</head>
<body>
  <nav class="navbar" id="navbar">
    <div class="container">
      <a href="{{ url_for('public.index') }}" class="nav-brand">Miramar <span>SG</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu">☰</button>
      {% set current_endpoint = request.endpoint or '' %}
      {% set rooms_active = current_endpoint in ['public.rooms', 'public.room_detail', 'customer.search', 'customer.book_room'] %}
      {% set account_active = current_endpoint.startswith('customer.') %}
      {% set admin_active = current_endpoint.startswith('admin.') %}
      {% set login_active = current_endpoint in ['auth.login', 'auth.password_recovery', 'auth.reset_password'] %}
      <ul class="nav-links" id="navLinks">
        <li><a href="{{ url_for('public.index') }}" class="{% if current_endpoint == 'public.index' %}active{% endif %}" {% if current_endpoint == 'public.index' %}aria-current="page"{% endif %}>Home</a></li>
        <li><a href="{{ url_for('public.about') }}" class="{% if current_endpoint == 'public.about' %}active{% endif %}" {% if current_endpoint == 'public.about' %}aria-current="page"{% endif %}>About</a></li>
        <li><a href="{{ url_for('public.rooms') }}" class="{% if rooms_active %}active{% endif %}" {% if rooms_active %}aria-current="page"{% endif %}>Rooms</a></li>
        <li><a href="{{ url_for('public.attractions') }}" class="{% if current_endpoint == 'public.attractions' %}active{% endif %}" {% if current_endpoint == 'public.attractions' %}aria-current="page"{% endif %}>Attractions</a></li>
        <li><a href="{{ url_for('public.location') }}" class="{% if current_endpoint == 'public.location' %}active{% endif %}" {% if current_endpoint == 'public.location' %}aria-current="page"{% endif %}>Location</a></li>
        <li><a href="{{ url_for('public.contact') }}" class="{% if current_endpoint in ['public.contact', 'public.feedback'] %}active{% endif %}" {% if current_endpoint in ['public.contact', 'public.feedback'] %}aria-current="page"{% endif %}>Contact</a></li>
        {% if current_user.is_authenticated %}
          {% if current_user.is_admin %}
            <li><a href="{{ url_for('admin.dashboard') }}" class="{% if admin_active %}active{% endif %}" {% if admin_active %}aria-current="page"{% endif %}>Admin</a></li>
          {% else %}
            <li><a href="{{ url_for('customer.dashboard') }}" class="{% if account_active %}active{% endif %}" {% if account_active %}aria-current="page"{% endif %}>My Account</a></li>
          {% endif %}
          <li><a href="{{ url_for('auth.logout') }}">Logout</a></li>
        {% else %}
          <li><a href="{{ url_for('auth.login') }}" class="{% if login_active %}active{% endif %}" {% if login_active %}aria-current="page"{% endif %}>Login</a></li>
          <li><a href="{{ url_for('auth.register') }}" class="btn btn-primary btn-sm {% if current_endpoint == 'auth.register' %}active{% endif %}" {% if current_endpoint == 'auth.register' %}aria-current="page"{% endif %}>Register</a></li>
        {% endif %}
      </ul>
    </div>
  </nav>

  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      <div class="container" style="padding-top: 5.5rem; position: relative; z-index: 50;">
        {% for category, message in messages %}
          <div class="alert alert-{{ category }}">{{ message }}</div>
        {% endfor %}
      </div>
    {% endif %}
  {% endwith %}

  {% block content %}{% endblock %}

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h4>{{ hotel_name }}</h4>
          <p style="margin-bottom:1rem; opacity:0.85;">{{ hotel_tagline }}</p>
          <p style="font-size:0.9rem;">{{ hotel_address }}</p>
          <p style="font-size:0.9rem;">{{ hotel_phone }}</p>
          <p style="font-size:0.9rem;">{{ hotel_email }}</p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul style="list-style:none; line-height:2;">
            <li><a href="{{ url_for('public.rooms') }}">Rooms & Suites</a></li>
            <li><a href="{{ url_for('public.about') }}">About Us</a></li>
            <li><a href="{{ url_for('public.attractions') }}">Attractions</a></li>
            <li><a href="{{ url_for('public.location') }}">Location</a></li>
          </ul>
        </div>
        <div>
          <h4>Guest Services</h4>
          <ul style="list-style:none; line-height:2;">
            <li><a href="{{ url_for('public.contact') }}">Contact Us</a></li>
            <li><a href="{{ url_for('public.feedback') }}">Leave Feedback</a></li>
            <li><a href="{{ url_for('auth.login') }}">Guest Login</a></li>
            <li><a href="{{ url_for('auth.register') }}">Register</a></li>
          </ul>
        </div>
        <div>
          <h4>Quick Links</h4>
          <ul style="list-style:none; line-height:2;">
            <li><a href="{{ url_for('public.rooms') }}">Book a Room</a></li>
            <li><a href="{{ url_for('public.contact') }}">Enquiries</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        &copy; {{ 2026 }} {{ hotel_name }}. All rights reserved. | Aptech eProject
      </div>
    </div>
  </footer>

  <script src="{{ url_for('static', filename='js/main.js') }}"></script>
  {% block extra_js %}{% endblock %}
</body>
</html>
