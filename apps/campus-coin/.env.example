DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Comma separated, e.g. https://campuscoin.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
MYSQL_DATABASE=campus_coin
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=0
# Local-only fallback while MySQL/MariaDB is unavailable. Keep false for MySQL.
USE_SQLITE=false
# Password-reset links point here (the React app).
FRONTEND_URL=http://127.0.0.1:5174
# Same-origin deployment (cPanel) can set this to false.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Initial authorised administrator (created once, manually)
ADMIN_EMAIL=abodaniel435@gmail.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Demo student login for reviewers
DEMO_PASSWORD=change-me-too
