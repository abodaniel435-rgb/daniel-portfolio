# ── ForgeStack generated application ─────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
# On cPanel, create the database and user first, then run the installer:
#   https://yourdomain.com/install.php?key=YOUR_INSTALL_KEY

# Application
APP_NAME="Kite Courier"
APP_URL=https://example.com
APP_TIMEZONE=Africa/Lagos
APP_DEBUG=false

# MySQL (cPanel usually prefixes the database and user with your account name)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpuser_forge_kite_courier
DB_USER=cpuser_siteuser
DB_PASS=change-this-database-password

# Outgoing mail. When MAIL_ENABLED=false every message is queued in the
# email_outbox table and can be reviewed in the admin desk.
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Kite Courier"

# One-time installer guard. Use a long random value; delete or rotate it after
# installation. install.php refuses to run without a matching key.
INSTALL_KEY=change-this-install-key

# The administrator created by install.php. Choose a unique password of at
# least 10 characters; it is hashed with password_hash() and never stored in
# plain text by the application.
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-admin-password

# Protects cron/run.php when it is triggered over HTTP
# (cron/run.php?key=YOUR_CRON_SECRET). Command-line runs do not need it.
CRON_SECRET=change-this-cron-secret
